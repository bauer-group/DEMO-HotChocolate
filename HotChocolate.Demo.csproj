<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>HotChocolate.Demo</RootNamespace>
    <AssemblyName>HotChocolate.Demo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- HotChocolate v14 - GraphQL Server -->
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.6.8" />
    <PackageReference Include="HotChocolate.Data" Version="16.6.8" />
    <PackageReference Include="HotChocolate.Data.EntityFramework" Version="16.6.8" />
    <PackageReference Include="HotChocolate.Subscriptions.InMemory" Version="16.6.8" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="16.6.8" />

    <!-- EF Core (In-Memory fuer die Demo) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.32" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.32" />

    <!-- Authentifizierung (Demo: JWT) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.32" />

    <!-- Logging / OpenTelemetry (optional) -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

</Project>
