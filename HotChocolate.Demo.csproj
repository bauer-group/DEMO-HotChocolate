<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>HotChocolate.Demo</RootNamespace>
    <AssemblyName>HotChocolate.Demo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- HotChocolate v14 - GraphQL Server -->
    <PackageReference Include="HotChocolate.AspNetCore" Version="14.3.1" />
    <PackageReference Include="HotChocolate.Data" Version="14.3.1" />
    <PackageReference Include="HotChocolate.Data.EntityFramework" Version="14.3.1" />
    <PackageReference Include="HotChocolate.Subscriptions.InMemory" Version="14.3.1" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="14.3.1" />

    <!-- EF Core (In-Memory fuer die Demo) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.20" />

    <!-- Authentifizierung (Demo: JWT) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.31" />

    <!-- Logging / OpenTelemetry (optional) -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

</Project>
